{
  "name": "simpul-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "test": "npm run build && vitest run tests/unit",
    "test:integration": "npm run build && vitest run tests/integration tests/regression",
    "format": "prettier --write . && eslint --fix --fix-type layout .",
    "format:check": "prettier --check . && eslint --max-warnings=0 .",
    "lint": "eslint --max-warnings=0 .",
    "lint:files": "eslint --max-warnings=0 --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "prettier --check . && eslint --max-warnings=0 . && tsc --noEmit && knip",
    "prepare": "husky"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "supertest": "7.2.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
